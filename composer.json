{
    "name": "decodelabs/labs-playground",
    "description": "Example playground app for testing DecodeLabs features ",
    "type": "project",
    "keywords": [ ],
    "license": "MIT",
    "authors": [ {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        } ],
    "require": {
        "php": "^8.4",
        "decodelabs/exceptional": "^0.6",
        "decodelabs/fabric": "^0.10",
        "decodelabs/greenleaf": "^0.10",
        "decodelabs/harvest": "^0.7",
        "decodelabs/horizon": "^0.5",
        "decodelabs/kingdom": "^0.2",
        "decodelabs/tagged": "^0.21",
        "decodelabs/zest": "^0.9"
    },
    "require-dev": {
        "decodelabs/phpstan-decodelabs": "^0.7.0"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\Playground\\": "src/"
        }
    },
    "extra": {
        "genesis": {
            "hub": "DecodeLabs\\Fabric\\Genesis\\Hub"
        },
        "effigy": {
            "entry": "vendor/genesis.php",
            "codeDirs": [
                "config",
                "src"
            ],
            "exports": [
                ".iota",
                "public",
                "pnpm-lock.yaml",
                "pnpm-workspace.yaml"
            ]
        },
        "branch-alias": {
            "dev-develop": "0.1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "decodelabs/genesis": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
    }
}
