<?php

declare(strict_types=1);

namespace DecodeLabs\Greenleaf\Router;

use DecodeLabs\Greenleaf\Route\Action as Route2;
use DecodeLabs\Greenleaf\Route\Hit as Hit;
use DecodeLabs\Greenleaf\Route\Page as Route1;
use DecodeLabs\Greenleaf\Router as Router;
use DecodeLabs\Monarch as Monarch;
use DecodeLabs\Singularity\Url\Leaf as LeafUrl;
use Psr\Http\Message\ServerRequestInterface as PsrRequest;
use Throwable as Throwable;

return new class implements Router
{
    public function matchIn(
        PsrRequest $request
    ): ?Hit {
        try {
            $path = ltrim($request->getUri()->getPath(), '/');
            
            if ($path === '') {
                $parts = [];
            } else {
                $parts = explode('/', $path);
            }
            
            $params = [];
            $method = $request->getMethod();
            $part = array_shift($parts);
            
            if($part === null) {
                if(in_array($method, ['GET'])) {
                    $params = array_merge([
                        'test' => 'hello'
                    ], $params);
                    
                    $valid = true;
                    $potentialRoute = Route1::fromArray([
                        'target' => 'leaf:/index.php',
                        'pattern' => '/',
                        'methods' => [
                            'GET'
                        ],
                        'parameters' => [
                            'test' => [
                                'name' => 'test',
                                'default' => 'hello'
                            ]
                        ]
                    ]);
                    
                    foreach($potentialRoute->parameters as $parameter) {
                        if(!$parameter->validate($params[$parameter->name])) {
                            $valid = false;
                            break;
                        }
                    
                        $params[$parameter->name] = $parameter->resolve($params[$parameter->name]);
                    }
                    
                    if($valid) {
                        return new Hit($potentialRoute, $params);
                    }
                }
            
                return null;
            }
            switch($part) {
                case 'test':
                    $part = array_shift($parts);
                    
                    if($part === null) {
                            return null;
                    }
                    if (preg_match('/^(?P<part1>\w+)$/', $part, $matches)) {
                        $hit = (function($parts) use ($matches, $method, $params) {
                            $params['part1'] = $matches['part1'];
                            $part = array_shift($parts);
                            
                            if($part === null) {
                                    return null;
                            }
                            if (preg_match('/^test\-(?P<part2>\w+)$/', $part, $matches)) {
                                $params['part2'] = $matches['part2'];
                                $part = array_shift($parts);
                                
                                if($part === null) {
                                        return null;
                                }
                                if (preg_match('/^$/', $part, $matches)) {
                                    
                                    $part = array_shift($parts);
                                    
                                    if($part === null) {
                                        if(in_array($method, ['GET'])) {
                                            $valid = true;
                                            $potentialRoute = Route1::fromArray([
                                                'target' => 'leaf:/complex-route.php',
                                                'pattern' => '/test/{part1}/test-{part2}/',
                                                'methods' => [
                                                    'GET'
                                                ],
                                                'parameters' => [
                                                    'part1' => [
                                                        'name' => 'part1',
                                                        'default' => null
                                                    ],
                                                    'part2' => [
                                                        'name' => 'part2',
                                                        'default' => null
                                                    ]
                                                ]
                                            ]);
                                            
                                            foreach($potentialRoute->parameters as $parameter) {
                                                if(!$parameter->validate($params[$parameter->name])) {
                                                    $valid = false;
                                                    break;
                                                }
                                            
                                                $params[$parameter->name] = $parameter->resolve($params[$parameter->name]);
                                            }
                                            
                                            if($valid) {
                                                return new Hit($potentialRoute, $params);
                                            }
                                        }
                                    
                                        return null;
                                    }
                                    return null;
                                }
                                return null;
                            }
                            return null;
                        })($parts);
                        if($hit !== null) {
                            return $hit;
                        }
                    }
                    $multiParts = $parts;
                    array_unshift($multiParts, $part);
                    $multiPart = implode('/', $multiParts);
                    if (preg_match('/^(?P<part1>.+?)$/', $multiPart, $matches)) {
                        $hit = (function($parts) use ($matches, $method, $params) {
                            $params['part1'] = $matches['part1'];
                            $part = array_shift($parts);
                            
                            if(in_array($method, ['GET'])) {
                                $params = array_merge([
                                    'part2' => 'default'
                                ], $params);
                                
                                $valid = true;
                                $potentialRoute = Route1::fromArray([
                                    'target' => 'leaf:/complex-route.php',
                                    'pattern' => '/test/{part1}',
                                    'methods' => [
                                        'GET'
                                    ],
                                    'parameters' => [
                                        'part1' => [
                                            'type' => 'path',
                                            'name' => 'part1',
                                            'default' => null
                                        ],
                                        'part2' => [
                                            'name' => 'part2',
                                            'default' => 'default'
                                        ]
                                    ]
                                ]);
                                
                                foreach($potentialRoute->parameters as $parameter) {
                                    if(!$parameter->validate($params[$parameter->name])) {
                                        $valid = false;
                                        break;
                                    }
                                
                                    $params[$parameter->name] = $parameter->resolve($params[$parameter->name]);
                                }
                                
                                if($valid) {
                                    return new Hit($potentialRoute, $params);
                                }
                            }
                            return null;
                        })($parts);
                        if($hit !== null) {
                            return $hit;
                        }
                    }
                    return null;
                    break;
                
                case 'fragments':
                    $part = array_shift($parts);
                    
                    
                    switch($part) {
                        case 'tab':
                            $part = array_shift($parts);
                            
                            if($part === null) {
                                    return null;
                            }
                            if (preg_match('/^(?P<tab>\w+)$/', $part, $matches)) {
                                $params['tab'] = $matches['tab'];
                                $part = array_shift($parts);
                                
                                if($part === null) {
                                    if(in_array($method, ['GET', 'POST'])) {
                                        $params = array_merge([
                                            'tab' => '1'
                                        ], $params);
                                        
                                        $valid = true;
                                        $potentialRoute = Route2::fromArray([
                                            'target' => 'leaf:/fragments/tab',
                                            'pattern' => '/fragments/tab/{tab}',
                                            'methods' => [
                                                'GET',
                                                'POST'
                                            ],
                                            'parameters' => [
                                                'tab' => [
                                                    'name' => 'tab',
                                                    'default' => '1'
                                                ]
                                            ]
                                        ]);
                                        
                                        foreach($potentialRoute->parameters as $parameter) {
                                            if(!$parameter->validate($params[$parameter->name])) {
                                                $valid = false;
                                                break;
                                            }
                                        
                                            $params[$parameter->name] = $parameter->resolve($params[$parameter->name]);
                                        }
                                        
                                        if($valid) {
                                            return new Hit($potentialRoute, $params);
                                        }
                                    }
                                
                                    return null;
                                }
                                return null;
                            }
                            return null;
                            break;
                        
                        case 'island-content':
                            $part = array_shift($parts);
                            
                            if($part === null) {
                                if(in_array($method, ['GET'])) {
                                    return new Hit(Route2::fromArray([
                                        'target' => 'leaf:/fragments/island-content',
                                        'pattern' => '/fragments/island-content',
                                        'methods' => [
                                            'GET'
                                        ]
                                    ]), $params);
                                }
                            
                                return null;
                            }
                            return null;
                            break;
                        
                        default:
                            return null;
                    }
                    break;
                
                case 'tabs':
                    $part = array_shift($parts);
                    
                    if($part === null) {
                        if(in_array($method, ['GET'])) {
                            return new Hit(Route1::fromArray([
                                'target' => 'leaf:/tabs.php',
                                'pattern' => '/tabs',
                                'methods' => [
                                    'GET'
                                ]
                            ]), $params);
                        }
                    
                        return null;
                    }
                    return null;
                    break;
                
                case 'slow':
                    $part = array_shift($parts);
                    
                    if($part === null) {
                        if(in_array($method, ['GET'])) {
                            return new Hit(Route1::fromArray([
                                'target' => 'leaf:/slow.php',
                                'pattern' => '/slow',
                                'methods' => [
                                    'GET'
                                ]
                            ]), $params);
                        }
                    
                        return null;
                    }
                    return null;
                    break;
                
                case 'propagate':
                    $part = array_shift($parts);
                    
                    if($part === null) {
                        if(in_array($method, ['GET'])) {
                            return new Hit(Route1::fromArray([
                                'target' => 'leaf:/propagate.php',
                                'pattern' => '/propagate',
                                'methods' => [
                                    'GET'
                                ]
                            ]), $params);
                        }
                    
                        return null;
                    }
                    return null;
                    break;
                
                case 'form':
                    $part = array_shift($parts);
                    
                    if($part === null) {
                        if(in_array($method, ['GET', 'POST'])) {
                            return new Hit(Route1::fromArray([
                                'target' => 'leaf:/form.php',
                                'pattern' => '/form',
                                'methods' => [
                                    'GET',
                                    'POST'
                                ]
                            ]), $params);
                        }
                    
                        return null;
                    }
                    return null;
                    break;
                
                default:
                    if (preg_match('/^test\-(?P<part1>\w+)\-(?P<part2>\w+)$/', $part, $matches)) {
                        foreach(['part1', 'part2'] as $name) {
                            $params[$name] = $matches[$name];
                        }
                        
                        $part = array_shift($parts);
                        
                        if($part === null) {
                            if(in_array($method, ['GET'])) {
                                $valid = true;
                                $potentialRoute = Route1::fromArray([
                                    'target' => 'leaf:/complex-route.php?linear',
                                    'pattern' => '/test-{part1}-{part2}',
                                    'methods' => [
                                        'GET'
                                    ],
                                    'parameters' => [
                                        'part1' => [
                                            'name' => 'part1',
                                            'default' => null
                                        ],
                                        'part2' => [
                                            'name' => 'part2',
                                            'default' => null
                                        ]
                                    ]
                                ]);
                                
                                foreach($potentialRoute->parameters as $parameter) {
                                    if(!$parameter->validate($params[$parameter->name])) {
                                        $valid = false;
                                        break;
                                    }
                                
                                    $params[$parameter->name] = $parameter->resolve($params[$parameter->name]);
                                }
                                
                                if($valid) {
                                    return new Hit($potentialRoute, $params);
                                }
                            }
                        
                            return null;
                        }
                        return null;
                    }
                    return null;
            };
        } catch (Throwable $e) {
            if (Monarch::isDevelopment()) {
                dd($e);
            }

            throw $e;
        }
    }

    public function matchOut(
        string|LeafUrl $uri,
        ?array $parameters = null
    ): ?Hit {
        $parameters ??= [];
        
        if (is_string($uri)) {
            $uri = LeafUrl::fromString($uri);
        }
        
        $groupData = [];
        switch($uri->getPath()) {
            case '/complex-route.php':
                $groupData = [
                    '/test/{part1}/test-{part2}/' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                            'part1',
                            'part2'
                        ],
                        'route' => fn() => Route1::fromArray([
                            'target' => 'leaf:/complex-route.php',
                            'pattern' => '/test/{part1}/test-{part2}/',
                            'methods' => [
                                'GET'
                            ],
                            'parameters' => [
                                'part1' => [
                                    'name' => 'part1',
                                    'default' => null
                                ],
                                'part2' => [
                                    'name' => 'part2',
                                    'default' => null
                                ]
                            ]
                        ])
                    ],
                    '/test/{part1}' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                            'part1',
                            'part2'
                        ],
                        'route' => fn() => Route1::fromArray([
                            'target' => 'leaf:/complex-route.php',
                            'pattern' => '/test/{part1}',
                            'methods' => [
                                'GET'
                            ],
                            'parameters' => [
                                'part1' => [
                                    'type' => 'path',
                                    'name' => 'part1',
                                    'default' => null
                                ],
                                'part2' => [
                                    'name' => 'part2',
                                    'default' => 'default'
                                ]
                            ]
                        ])
                    ],
                    '/test-{part1}-{part2}' => [
                        'queryKeys' => [
                            'linear'
                        ],
                        'paramNames' => [
                            'part1',
                            'part2'
                        ],
                        'route' => fn() => Route1::fromArray([
                            'target' => 'leaf:/complex-route.php?linear',
                            'pattern' => '/test-{part1}-{part2}',
                            'methods' => [
                                'GET'
                            ],
                            'parameters' => [
                                'part1' => [
                                    'name' => 'part1',
                                    'default' => null
                                ],
                                'part2' => [
                                    'name' => 'part2',
                                    'default' => null
                                ]
                            ]
                        ])
                    ]
                ];
                break;
            
            case '/fragments/tab':
                $groupData = [
                    '/fragments/tab/{tab}' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                            'tab'
                        ],
                        'route' => fn() => Route2::fromArray([
                            'target' => 'leaf:/fragments/tab',
                            'pattern' => '/fragments/tab/{tab}',
                            'methods' => [
                                'GET',
                                'POST'
                            ],
                            'parameters' => [
                                'tab' => [
                                    'name' => 'tab',
                                    'default' => '1'
                                ]
                            ]
                        ])
                    ]
                ];
                break;
            
            case '/fragments/island-content':
                $groupData = [
                    '/fragments/island-content' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                        ],
                        'route' => fn() => Route2::fromArray([
                            'target' => 'leaf:/fragments/island-content',
                            'pattern' => '/fragments/island-content',
                            'methods' => [
                                'GET'
                            ]
                        ])
                    ]
                ];
                break;
            
            case '/tabs.php':
                $groupData = [
                    '/tabs' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                        ],
                        'route' => fn() => Route1::fromArray([
                            'target' => 'leaf:/tabs.php',
                            'pattern' => '/tabs',
                            'methods' => [
                                'GET'
                            ]
                        ])
                    ]
                ];
                break;
            
            case '/slow.php':
                $groupData = [
                    '/slow' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                        ],
                        'route' => fn() => Route1::fromArray([
                            'target' => 'leaf:/slow.php',
                            'pattern' => '/slow',
                            'methods' => [
                                'GET'
                            ]
                        ])
                    ]
                ];
                break;
            
            case '/propagate.php':
                $groupData = [
                    '/propagate' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                        ],
                        'route' => fn() => Route1::fromArray([
                            'target' => 'leaf:/propagate.php',
                            'pattern' => '/propagate',
                            'methods' => [
                                'GET'
                            ]
                        ])
                    ]
                ];
                break;
            
            case '/form.php':
                $groupData = [
                    '/form' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                        ],
                        'route' => fn() => Route1::fromArray([
                            'target' => 'leaf:/form.php',
                            'pattern' => '/form',
                            'methods' => [
                                'GET',
                                'POST'
                            ]
                        ])
                    ]
                ];
                break;
            
            case '/index.php':
                $groupData = [
                    '/' => [
                        'queryKeys' => [
                        ],
                        'paramNames' => [
                            'test'
                        ],
                        'route' => fn() => Route1::fromArray([
                            'target' => 'leaf:/index.php',
                            'pattern' => '/',
                            'methods' => [
                                'GET'
                            ],
                            'parameters' => [
                                'test' => [
                                    'name' => 'test',
                                    'default' => 'hello'
                                ]
                            ]
                        ])
                    ]
                ];
                break;
            
            default:
                return null;
        }
        $origQuery = $uri->parseQuery();
        foreach($groupData as $group) {
            foreach($group['queryKeys'] as $key) {
                if(!isset($origQuery->{$key})) {
                    continue 2;
                }
            }
            $query = clone $origQuery;
            $params = [];
            foreach($query as $key => $node) {
                if(!is_string($key) || !$node->hasValue()) {
                    continue;
                }
                if(in_array($key, $group['queryKeys'])) {
                    unset($query->{$key});
                    continue;
                }
                if(in_array($key, $group['paramNames'])) {
                    $params[$key] = $node->getValue();
                    unset($query->{$key});
                    continue;
                }
                continue 2;
            }
            $params = array_merge($params, $parameters);
            $route = $group['route']();
            foreach($route->parameters as $name => $parameter) {
                if(isset($params[$name])) {
                    continue;
                }
        
                if($parameter->hasDefault()) {
                    $params[$name] = $parameter->default;
                    continue;
                }
        
                continue 2;
            }
            return new Hit($route, $params, $query->toDelimitedString());
        }
        return null;;
    }
};